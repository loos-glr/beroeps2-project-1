# Front controller binnen httpdocs/.
# De root-.htaccess stuurt /beroeps2/project-1/... intern door naar httpdocs/.
# RewriteBase is hier de URL van DEZE map (…/httpdocs/); voor directe toegang
# en voor lokaal gebruik op Apache.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /beroeps2/project-1/httpdocs/

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
