# Front controller binnen public/.
# De root-.htaccess stuurt /beroeps2/project-1/... intern door naar public/.
# RewriteBase is hier de URL van DEZE map (…/public/); voor directe toegang
# en voor lokaal gebruik op Apache.
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /beroeps2/project-1/public/

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>
